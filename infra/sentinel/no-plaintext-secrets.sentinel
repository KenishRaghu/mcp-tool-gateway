# Credentials must come from Secrets Manager (`secrets`), never plaintext env vars.
import "common"

violations = []
for common.containers() as addr, cs {
  for cs as c {
    for (c.environment else []) as e {
      if e.name matches "(?i)(token|secret|password|api_key|private_key|signing_key)" {
        append(violations, addr + ": " + c.name + " has secret-like env var '" + e.name + "' in plaintext")
      }
    }
    secret_names = []
    for (c.secrets else []) as s {
      append(secret_names, s.name)
    }
    if c.name is "mcp-gateway" and "GATEWAY_SIGNING_KEY" not in secret_names {
      append(violations, addr + ": GATEWAY_SIGNING_KEY must be injected from Secrets Manager")
    }
  }
}

main = rule { common.report("no-plaintext-secrets", violations) }
