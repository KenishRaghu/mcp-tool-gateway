# Shared helpers for the gateway rollout policies (imported as "common").
import "tfplan/v2" as tfplan
import "json"

# Managed resources of a type that are being created or updated.
changes = func(type) {
  return filter tfplan.resource_changes as _, rc {
    rc.type is type and rc.mode is "managed" and
      (rc.change.actions contains "create" or rc.change.actions contains "update")
  }
}

# Containers from every ECS task definition being created/updated: {address: [containers]}.
containers = func() {
  out = {}
  for changes("aws_ecs_task_definition") as addr, rc {
    out[addr] = json.unmarshal(rc.change.after.container_definitions)
  }
  return out
}

# Container env list -> map.
env_map = func(c) {
  m = {}
  for (c.environment else []) as e {
    m[e.name] = e.value
  }
  return m
}

report = func(name, violations) {
  for violations as v {
    print(name + ": " + v)
  }
  return length(violations) is 0
}
